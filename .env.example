# Copy file này thành .env rồi điền giá trị. KHÔNG commit file .env.
# Khi deploy (Render): khai báo các biến này trong tab Environment.

# ===== App URLs =====
PORT=5003
# URL public của BE — local: http://localhost:5003 | deploy: https://prolaptop-server.onrender.com
SERVER_URL=http://localhost:5003
# URL của FE — local: http://localhost:5173 | deploy: URL Vercel của FE
# Có thể khai báo nhiều URL, phân tách bằng dấu phẩy (URL đầu tiên dùng để redirect sau login Google)
# Nhớ thêm origin của Expo web (mặc định http://localhost:8081) nếu chạy app mobile trên trình duyệt
CLIENT_URL=http://localhost:5173,http://localhost:8081

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chuỗi ngẫu nhiên, ví dụ: openssl rand -hex 32
SESSION_SECRET=

# ===== ZaloPay =====
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT_CREATE=
ZALOPAY_ENDPOINT_QUERY=
ZALOPAY_REDIRC_URL=http://localhost:5173
